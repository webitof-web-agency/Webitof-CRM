# Copy to frontend/.env for local development (frontend/.env is gitignored).
# Vite bakes these into the build: in production they come from GitHub repository variables
# (Settings → Secrets and variables → Actions → Variables) used by .github/workflows/deploy.yml.
# Everything here ends up in the browser, so never put a secret in a VITE_ variable.

# ─── API ─────────────────────────────────────────────────────────
# Backend API base URL. Leave empty: local dev uses the Vite proxy at /api, production
# builds fall back to https://crmapi.webitof.com/api.
VITE_API_URL=
# Socket.io server for live notifications. Leave empty to use the API URL's server.
VITE_SOCKET_URL=

# ─── Google Maps (HRM: Work locations, Live board, My Day clock-in map) ───
# Optional: without a key the HRM screens show a "View on Google Maps" link instead of a map.
# Google Cloud Console → APIs & Services:
#   1. Library → enable "Maps JavaScript API" (billing must be linked to the project).
#   2. Credentials → Create credentials → API key.
#   3. Edit the key:
#      Application restrictions → Websites → add the FRONTEND address(es) the CRM opens at,
#        e.g. https://crm.example.com/*  and  http://localhost:5173/*
#        (not the backend API address: the map loads in the browser on the CRM page).
#      API restrictions → Restrict key → only "Maps JavaScript API".
# Production: add the same key as repository variable VITE_GOOGLE_MAPS_API_KEY, and make sure the
# frontend build step in .github/workflows/deploy.yml passes it in its env block.
VITE_GOOGLE_MAPS_API_KEY=
