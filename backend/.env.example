PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webitof_crm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=webitof_crm
DB_SSL=false
AUTO_INIT_DB=true
SEED_DEFAULT_DATA=true
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_SIZE_BYTES=26214400
JWT_SECRET=change-this-in-production
# Optional one-time bootstrap admin. Leave unset after seeding.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Advanced Follow-up Engine
FOLLOW_UP_AUTOMATION_CRON=*/10 * * * *
FOLLOW_UP_TIMEZONE=Asia/Kolkata

# SMTP / Hostinger mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_NAME=Webitof CRM
SMTP_FROM_EMAIL=your-email@yourdomain.com

# Google Drive storage
# Option 1: service account JSON contents in env
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option 2: service account key file path
GOOGLE_APPLICATION_CREDENTIALS=

# Option 3: OAuth refresh token flow
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost

# Put your shared folder ID here if you want uploads to land inside an existing folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Webitof CRM Files
GOOGLE_DRIVE_PUBLIC_FILES=false
