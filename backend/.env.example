PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webitof_crm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=webitof_crm
DB_SSL=false
AUTO_INIT_DB=true
SEED_DEFAULT_DATA=true
# Demo clients, projects, AMCs, renewals and notifications. Never enable on a live install.
SEED_DEMO_DATA=false
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_SIZE_BYTES=26214400
JWT_SECRET=change-this-in-production
# Optional one-time bootstrap admin. Leave unset after seeding.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Advanced Follow-up Engine
FOLLOW_UP_AUTOMATION_CRON=*/10 * * * *
FOLLOW_UP_TIMEZONE=Asia/Kolkata

# SMTP / Hostinger mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_NAME=Webitof CRM
SMTP_FROM_EMAIL=your-email@yourdomain.com

# ─── File storage ────────────────────────────────────────────────
# Default for new uploads until a choice is saved in Settings → Storage & Backup: local | gdrive
STORAGE_PROVIDER=local
# Where "local" files are kept (default: backend/uploads/files). Keep it outside deploy syncs.
LOCAL_STORAGE_DIR=

# ─── Google Drive (uploads + daily database backups) ─────────────
# Everything in this section (and the backup schedule below) can instead be set in
# Settings → Storage & Backup; a value saved there overrides the env var.
# No Google sign-in through the app: create an OAuth client ("Web application", Drive API
# enabled, authorized redirect URI https://developers.google.com/oauthplayground), then in the
# OAuth 2.0 Playground use your own credentials, scope https://www.googleapis.com/auth/drive,
# and copy the refresh token. Publish the consent screen ("In production"): in Testing mode
# Google expires refresh tokens after 7 days. Then Settings → Storage & Backup → Check connection.
# The older GOOGLE_DRIVE_CLIENT_ID / _SECRET / _REFRESH_TOKEN names are still read.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Server-only. 64 hex chars (openssl rand -hex 32). Encrypts the secrets and token saved
# in Settings. Never change it.
SETTINGS_ENCRYPTION_KEY=
# Optional folder id or link that holds both app folders (empty = My Drive root).
GDRIVE_PARENT_FOLDER_ID=
GDRIVE_UPLOADS_FOLDER_NAME=Webitof CRM – Uploads
GDRIVE_BACKUP_FOLDER_NAME=Webitof CRM – DB Backups

# ─── Database backups (pg_dump → Google Drive) ───────────────────
# Backups kept in Drive (max 100). One a day, so 15 = the last 15 days.
GDRIVE_BACKUP_KEEP=15
# Daily backup hour in India time (0–23); -1 turns the schedule off (use it for dev/test servers).
GDRIVE_BACKUP_HOUR_IST=2
# pg_dump binary; its major version must be >= the PostgreSQL server's.
PG_DUMP_PATH=pg_dump
# Separate connection for pg_dump / restore. On Supabase use the SESSION pooler (port 5432)
# or the direct connection: a restore runs as one transaction, which the transaction pooler cannot do.
BACKUP_DATABASE_URL=

# ─── One-click restore (Settings → Storage & Backup → Restore) ───
# Needs pg_restore and psql (same major version as the server or newer). The site goes into
# maintenance (every API call answers 503) until the restore finishes.
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql
RESTORE_TIMEOUT_MINUTES=30

# HRM realtime automation (reminders, offline/geofence checks, 23:59 absent marking)
HRM_AUTOMATION_ENABLED=true
HRM_REALTIME_CRON=*/5 * * * *
HRM_TIMEZONE=Asia/Kolkata
# Daily HRM job runs at HRM_AUTOMATION_CRON (default 01:30) as a built-in system identity; no user id needed.

# Firebase Cloud Messaging service-account JSON for employee-app push (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Secret key website forms send to POST /api/leads/webhook (required in production)
LEAD_WEBHOOK_KEY=

# AMC/renewal automation: items overdue longer than this are not emailed/invoiced automatically
AUTOMATION_OVERDUE_GRACE_DAYS=30

# Local machine on the live DB: skip schema setup/seeding and all crons (the deployed server owns them)
# ALLOW_PROD_DEV=true
# SKIP_DB_SETUP=true
# DISABLE_SCHEDULERS=true
