PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webitof_crm
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=webitof_crm
DB_SSL=false
# Pool size, how long a request waits for a free connection (ms) before answering 503, and how long
# Postgres lets a transaction sit idle (ms) before ending it and freeing its locks.
DB_POOL_MAX=15
DB_POOL_ACQUIRE_TIMEOUT_MS=15000
DB_IDLE_TX_TIMEOUT_MS=60000
# Behind a reverse proxy (Traefik/Nginx) set the number of proxy hops, usually 1, so rate limits and
# audit logs see the real client IP. Leave empty when the API is reached directly.
TRUST_PROXY=
AUTO_INIT_DB=true
SEED_DEFAULT_DATA=true
# Demo clients, projects, AMCs, renewals and notifications. Never enable on a live install.
SEED_DEMO_DATA=false
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_SIZE_BYTES=26214400
JWT_SECRET=change-this-in-production
# Optional one-time bootstrap admin. Leave unset after seeding.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# Advanced Follow-up Engine
FOLLOW_UP_AUTOMATION_CRON=*/10 * * * *
FOLLOW_UP_TIMEZONE=Asia/Kolkata

# ─── Email (Hostinger SMTP) ──────────────────────────────────────
# Env only: Settings → SMTP & Email shows these read-only and can send a test mail per mailbox.
# Edit here and restart the server. Which mail goes from which mailbox: backend/config/mailSenders.js
#   billing   invoices, payment receipts/dues, AMC + renewal reminders (clients)
#   accounts  vendors, outsourcing payables, commissions, finance reports
#   hr        employees and candidates
#   support   project updates and other client notifications
#   noreply   password OTP, staff alerts, digests, system alerts
# Shared server settings (a mailbox can override with SMTP_<BOX>_HOST / _PORT / _SECURE):
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# One block per mailbox. USER is the mailbox address and the From address.
# FROM_NAME and REPLY_TO are optional.
SMTP_BILLING_USER=billing@webitof.com
SMTP_BILLING_PASSWORD=
SMTP_BILLING_FROM_NAME=Webitof Billing

SMTP_ACCOUNTS_USER=accounts@webitof.com
SMTP_ACCOUNTS_PASSWORD=
SMTP_ACCOUNTS_FROM_NAME=Webitof Accounts

SMTP_HR_USER=hr@webitof.com
SMTP_HR_PASSWORD=
SMTP_HR_FROM_NAME=Webitof HR

SMTP_SUPPORT_USER=support@webitof.com
SMTP_SUPPORT_PASSWORD=
SMTP_SUPPORT_FROM_NAME=Webitof Support

SMTP_NOREPLY_USER=noreply@webitof.com
SMTP_NOREPLY_PASSWORD=
SMTP_NOREPLY_FROM_NAME=Webitof
# Replies to no-reply mails (if anyone answers) land here instead.
SMTP_NOREPLY_REPLY_TO=support@webitof.com

# Optional default account: a mailbox with no USER/PASSWORD of its own sends through this one
# (still under the mailbox's name). Leave empty once all five mailboxes are set.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ─── File storage ────────────────────────────────────────────────
# Default for new uploads until a choice is saved in Settings → Storage & Backup: local | gdrive
STORAGE_PROVIDER=local
# Where "local" files are kept (default: backend/uploads/files). Keep it outside deploy syncs.
LOCAL_STORAGE_DIR=

# ─── Google Drive (uploads + daily database backups) ─────────────
# The client, allowed account and folders below are read from the env ONLY: Settings → Storage &
# Backup shows them read-only. (Only the backup schedule further down can also be changed there.)
# Edit them here and restart the server.
# Setup: Google Cloud → enable the Drive API → OAuth client "Web application" with the authorized
# redirect URI below. Publish the consent screen ("In production"): in Testing mode Google expires
# refresh tokens after 7 days. Then an admin clicks Settings → Storage & Backup → Connect Google
# Drive and signs in; the refresh token is kept encrypted in the database. If Google later refuses
# it, admins get a notification + email and the same button (Reconnect) makes a new one.
# The older GOOGLE_DRIVE_CLIENT_ID / _SECRET / _REFRESH_TOKEN names are still read.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only this Google account can be connected (empty = any account).
GDRIVE_ALLOWED_EMAIL=
# Must also be listed under "Authorized redirect URIs" of the OAuth client.
# Empty = built from the API address the admin uses (needs TRUST_PROXY behind Nginx for https).
GOOGLE_OAUTH_REDIRECT_URI=https://erpapi.webitof.com/api/google-drive/oauth/callback
# Optional fallback: a refresh token from the OAuth 2.0 Playground instead of the Connect button.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Calendar (each user connects their own calendar from Profile). Its own "Web application"
# OAuth client with the Calendar API enabled and the calendar.events scope on the consent screen.
# Empty = the Drive client above is used. Redirect URI (also listed on the OAuth client):
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://erpapi.webitof.com/api/google-calendar/oauth/callback
# Server-only. 64 hex chars (openssl rand -hex 32). Encrypts the Drive token kept in the
# database. Same value on every server that uses the database; never change it.
SETTINGS_ENCRYPTION_KEY=
# The main folder is always made at the top of the connected account's My Drive
# (GDRIVE_PARENT_FOLDER_ID is no longer read; one an older version put elsewhere is moved there).
# Connecting Drive makes this main folder with the whole tree inside (utils/uploadPath.js):
#   01 CRM / 02 Finance / 03 Services / 04 HRM / 05 Users / 06 Company / 07 General
#   e.g. 01 CRM/Leads/LD-2026-000017 - Vashi Tech/2026-11-27_brief.pdf
#        02 Finance/Invoices/FY 2026-27/11-Nov/INV-2026-0012 - Acme/...
# and the backups in <backup folder>/Database/<year>/<MM-Mon>/<YYYY-MM-DD>/.
GDRIVE_ROOT_FOLDER_NAME='Webitof ERP Data'
GDRIVE_BACKUP_FOLDER_NAME='Backups'

# ─── Database backups (pg_dump → Google Drive) ───────────────────
# GDRIVE_BACKUP_KEEP and GDRIVE_BACKUP_HOUR_IST can also be changed in Settings (that value wins).
# Daily (scheduled) backups kept in Drive (max 100). One a day, so 15 = the last 15 days.
GDRIVE_BACKUP_KEEP=15
# "Back up now" and the safety copy taken before a restore are kept apart from the daily ones
# (max 100 each), so clicking Back up now never pushes daily backups out. Server env only.
GDRIVE_BACKUP_KEEP_MANUAL=5
GDRIVE_BACKUP_KEEP_PRE_RESTORE=5
# Every backup is checked against Drive's MD5 after upload and carries its sha256 + size, checked
# again before a restore. A failed backup, or none succeeding for 36 hours, alerts everyone with
# settings.write (in-app + email, then once a day). Settings → Storage & Backup → Backup health
# shows pg_dump/pg_restore/psql vs the server version and the connection below.
# Daily backup hour in India time (0–23); -1 turns the schedule off (use it for dev/test servers).
GDRIVE_BACKUP_HOUR_IST=2
# pg_dump binary; its major version must be >= the PostgreSQL server's.
PG_DUMP_PATH=pg_dump
# Separate connection for pg_dump / restore. On Supabase use the SESSION pooler (port 5432)
# or the direct connection: a restore runs as one transaction, which the transaction pooler
# (port 6543) cannot do. Backup health warns when this (or DATABASE_URL) uses port 6543.
BACKUP_DATABASE_URL=

# ─── One-click restore (Settings → Storage & Backup → Restore) ───
# Needs pg_restore and psql (same major version as the server or newer). The site goes into
# maintenance (every API call answers 503) until the restore finishes.
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql
RESTORE_TIMEOUT_MINUTES=30

# HRM realtime automation (reminders, offline/geofence checks, 23:59 absent marking)
HRM_AUTOMATION_ENABLED=true
# Monthly leave credit runs nightly even when HRM_AUTOMATION_ENABLED is off; set false to stop it.
HRM_LEAVE_ACCRUAL_ENABLED=true
HRM_LEAVE_ACCRUAL_CRON=15 0 * * *
HRM_REALTIME_CRON=*/5 * * * *
HRM_TIMEZONE=Asia/Kolkata
# Daily HRM job runs at HRM_AUTOMATION_CRON (default 01:30) as a built-in system identity; no user id needed.

# Firebase Cloud Messaging service-account JSON for employee-app push (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Secret key website forms send to POST /api/leads/webhook (required in production)
LEAD_WEBHOOK_KEY=
# Webhook submissions allowed per IP per minute.
LEAD_WEBHOOK_MAX_PER_MINUTE=30

# AMC/renewal automation: items overdue longer than this are not emailed/invoiced automatically
AUTOMATION_OVERDUE_GRACE_DAYS=30

# Local machine on the live DB: skip schema setup/seeding and all crons (the deployed server owns them)
# ALLOW_PROD_DEV=true
# SKIP_DB_SETUP=true
# DISABLE_SCHEDULERS=true
