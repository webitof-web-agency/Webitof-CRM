{
  "name": "webitof-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js + PostgreSQL backend for the Webitof client management CRM",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "migrate:hrm": "node database/migrate-hrm.js",
    "test:hrm": "node --test tests/hrm.test.js tests/hrm.workday.test.js tests/hrmPayroll.test.js tests/hrmLeaveCancel.test.js tests/hrmLiveBoard.test.js tests/hrmCore.test.js tests/hrmGeofenceDebounce.test.js tests/hrmHolidayDelete.test.js tests/hrm.integration.js",
    "seed:hrm-demo": "node database/seed-hrm-demo.js --yes-seed-hrm",
    "seed:hrm-it": "node database/seed-hrm-it-masters.js --yes",
    "test:storage": "node --test tests/googleDrive.test.js tests/fileAccess.test.js",
    "test:security": "node --test tests/securityHardening.test.js tests/outsourcingAutomation.test.js tests/quotationApprovalPermission.test.js tests/followUpUpserts.test.js tests/fileAccess.test.js",
    "start": "node server.js",
    "predev": "node scripts/ensure-dev-db.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "seed:demo": "node database/seed-demo.js --yes-seed-demo",
    "seed:leads": "node scripts/seed_dummy_leads_30.js",
    "seed:follow-up-demo": "node database/seed-followup-feature-demo.js --yes-demo",
    "migrate:lead-upgrade": "node database/add-lead-management-upgrade.js",
    "migrate:follow-up-schema": "node database/apply-follow-up-schema.js",
    "backfill:follow-ups": "node database/backfill-follow-ups.js",
    "backfill:follow-ups:apply": "node database/backfill-follow-ups.js --apply",
    "seed:follow-ups": "node database/seed-follow-ups.js --yes-seed-followups",
    "test:follow-ups": "node --test tests/followUpEngine.test.js",
    "test:follow-up-api": "node tests/followUpApi.smoke.js",
    "test:leads": "node --test tests/leadManagement.test.js",
    "test:lead-api": "node tests/leadApi.smoke.js",
    "migrate:payment-status": "node database/add-payment-status.js",
    "migrate:expense-structure": "node database/add-expense-structure.js",
    "migrate:amc-structure": "node database/add-amc-structure.js",
    "db:keepalive": "node scripts/supabase-keepalive.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.3"
  }
}
